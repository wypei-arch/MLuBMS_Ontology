PREFIX bms: <http://example.org/bms#>
# Granularity selection (Step 3) input: buildings with an own observed
# average unit area (mep_subsys_drainage's "bool(A_unit)" branch). See
# own_occupancy_count.sparql for why this is a mandatory pattern, not an
# OPTIONAL alongside `?b a bms:Building`.
SELECT ?b ?avgUnitArea WHERE {
  ?b a bms:Building ; bms:averageUnitArea ?avgUnitArea .
} ORDER BY ?b
