    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="Necf95f507666481ca6210ef0e0030809"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#pumpPowerFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#PlumbingSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">pump power factor</rdfs:label>
    <rdfs:comment xml:lang="en">Empirical factor lambda1 (≈ 0.005) used to estimate pump power: P = lambda1 * V_tank * (H_building + H_friction).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#archetypeYearBucket">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Archetype"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Construction-year bucket this archetype represents: '&lt;1980', '1980-1999', or '&gt;=2000'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#count">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Component"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb4ca60de291f4f68b286640327d2edf6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/bms#hasGranularityLevel"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#ElectricalSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/bms#BuildingSystem"/>
    <calculationFormula>Wiring: L_electri=alpha_electri*GFA (alpha≈3 m/m2); S_electri=L_electri*w_electri. Cable tray/conduit: L_main=H_building*alpha_main (alpha_main≈1.1); L_branch=P_building*N_floor*alpha_branch (alpha_branch≈0.8); S=(L_main+L_branch)*A*t*rho_i.</calculationFormula>
    <rdfs:comment xml:lang="en">DATA PROVENANCE NOTE: alpha_electri, alpha_main, and alpha_branch are preliminary engineering design heuristics, not values codified in a single published standard. The relevant Singapore standard for electrical installations is SS 638:2018 Code of Practice for Electrical Installations (superseding CP5:1998), which specifies conduit/trunking/duct fill (space) factors (≤40%/45%/35%) but not an area-based wiring-length density factor; the specific numeric values used here could not be independently verified against SS 638:2018 at the time of writing. Treat as adjustable defaults.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#confidenceScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:nodeID="N61e08890d85c43fe939500dd2d218c88"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#policyContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Region"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N94f71c8d29fc4a0993953fb4670fdaf8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N81976e4dc3dc42d29e16496608c7040f"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#hasBuilding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
