<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns="http://example.org/bms#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/bms#Building">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Building</rdfs:label>
    <owl:disjointWith rdf:resource="http://example.org/bms#Material"/>
    <owl:disjointWith rdf:resource="http://example.org/bms#Site"/>
    <rdfs:subClassOf rdf:nodeID="Nb4ca60de291f4f68b286640327d2edf6"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bot#Building"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#VerticalTransportationSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/bms#BuildingSystem"/>
    <calculationFormula>Elevator: N_ele=GFA*alpha_ele; S_ele=N_ele*w_ele*p_i. Escalator: N_esc=GFA*alpha_esc; S_esc=N_esc*w_esc*p_i.</calculationFormula>
    <applicabilityCondition>Elevator: building type B2/B3/A2 AND N_f&gt;3. Escalator: building type A1 (commercial/retail) AND N_f&gt;3. [Corrected from a previous "D-metro" label, which did not match any code in the building function classification (bms:function): A1, A2, B1, B2, B3, C, D (Industrial), E, etc. — D is Industrial, not a transit/metro category, and no metro-station type is currently defined; escalators are scoped to A1 only unless a transit-facility type is added.]</applicabilityCondition>
    <rdfs:comment xml:lang="en">DATA PROVENANCE NOTE: elevatorDensityPerArea (alpha_ele) and escalatorDensityPerArea (alpha_esc) are an area-based proxy adopted for data-scarce, urban-scale estimation. The recognised lift-planning standard, ISO 8100-32:2020, sizes lifts from building population and peak-traffic handling capacity (e.g., offices: deliver ≥12% of building population within 5 minutes), not floor area \citep{iso8100-32}. No published standard was found using the specific area-density ranges given here; treat as adjustable defaults, not standard-derived constants.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#siteType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Site"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Material"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">String values follow the unit vocabulary of the Ontology of units of Measure (OM, e.g. "kg/m2", "m3") rather than being reified as om:Measure individuals, since this property is populated directly from the relational database and read by the SPARQL/Python reasoning pipeline as a plain literal.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#footprintPerimeter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Building"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#wallThickness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#StructuralSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#drainageBranchLengthFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#PlumbingSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">drainage branch pipe length factor</rdfs:label>
    <rdfs:comment xml:lang="en">Empirical density factor for branch drainage pipes (alpha_drain_branch, m/m2). Default ≈ 0.08 m/m2.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#ductThickness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#HVACSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">duct sheet thickness</rdfs:label>
    <rdfs:comment xml:lang="en">Sheet metal thickness of ductwork T_duct (m). Used in material stock calculation: S = 2*(a+b)*L_duct*T_duct*rho.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neb797587e5364a11b519160ac0f7274b">
