  <rdf:Description rdf:about="http://example.org/bms#unitRoutingDistance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#GasSupplySystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">unit routing distance</rdfs:label>
    <rdfs:comment xml:lang="en">Typical copper branch pipe routing distance per served unit (alpha_unit, m/unit). Residential: 3–8; Hotel: 8–20; Commercial (F&amp;B/restaurant kitchen, not general office/retail): 10–30. Engineering design heuristic; not codified in a single published standard.</rdfs:comment>
  </rdf:Description>
