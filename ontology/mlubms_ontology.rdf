  <rdf:Description rdf:nodeID="N3ee2f9e0a2204ae087d90740fcf6bd16">
    <rdf:first rdf:resource="http://example.org/bms#BuildingSystem"/>
    <rdf:rest rdf:nodeID="Nc6381cbc67e24760ac2e3847eae8b049"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#MaterialIntensity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Material Intensity</rdfs:label>
    <rdfs:comment xml:lang="en">A building's empirically observed material intensity coefficient (MIC, e.g. m3/m2) for one material, as recorded in building_material_intensity. Reified as its own individual (rather than a direct Building-Material decimal property) purely so archetype peer-averaging can be expressed declaratively over intensityValue via SPARQL AVG/GROUP BY, mirroring how StructuralSystem/HVACSystem/etc. are already reified per building.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#intensityValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#MaterialIntensity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#forMaterial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#MaterialIntensity"/>
    <rdfs:range rdf:resource="http://example.org/bms#Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#forBuilding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#MaterialIntensity"/>
    <rdfs:range rdf:resource="http://example.org/bms#Building"/>
    <rdfs:comment xml:lang="en">Deliberately a distinct property from bms:belongsToBuilding (domain BuildingSystem) rather than a reuse of it: MaterialIntensity is not a BuildingSystem, and reusing belongsToBuilding would let OWL 2 RL domain-entailment incorrectly classify every MaterialIntensity individual as a BuildingSystem.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#componentBelongsToBuilding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Component"/>
    <rdfs:range rdf:resource="http://example.org/bms#Building"/>
    <rdfs:comment xml:lang="en">Direct Component-to-Building shortcut for components (e.g. own-observed BIM interior_wall/column/beam/stair volumes) not otherwise attached to a reified BuildingSystem individual. Deliberately distinct from bms:belongsToBuilding (domain BuildingSystem): Component is declared owl:disjointWith BuildingSystem, so reusing belongsToBuilding would let OWL 2 RL domain-entailment classify every such Component as a BuildingSystem and, combined with the disjointness axiom, make the populated graph inconsistent.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
