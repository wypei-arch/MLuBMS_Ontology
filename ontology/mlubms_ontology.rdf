    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Building"/>
    <rdfs:range rdf:resource="http://example.org/bms#Site"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#airflowToCoolingLoadRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#HVACSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">airflow-to-cooling-load ratio</rdfs:label>
    <rdfs:comment xml:lang="en">Ratio k (m3/h per kW of cooling load) used to derive total AHU/ductwork supply airflow from the cooling load already computed for the chiller (Q_air = k * Q_total / 1000). For hot-humid tropical climates (e.g., Singapore), k ≈ 145–169 m3/h/kW, equivalent to the industry rule of thumb of 300–350 CFM/ton (lower than the 400 CFM/ton temperate-climate baseline, reflecting the need for longer coil contact time to remove latent/humidity load) \citep{accaCfmPerTon}.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd1a4fe3845e5453f931e632b280ec410">
    <rdf:first rdf:resource="http://example.org/bms#Material"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#peakDemandFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#PlumbingSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#applicabilityCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">applicability condition</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the building type or data conditions under which a calculation rule applies.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4a37589bad094abe9813090e19d89cba">
    <rdf:first rdf:resource="http://example.org/bms#Component"/>
    <rdf:rest rdf:nodeID="N4fef9ccef0b54788a7fe58ca8a7f76f3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#riserPipeUnitWeight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#GasSupplySystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">riser pipe unit weight</rdfs:label>
    <rdfs:comment xml:lang="en">Unit weight of the steel gas riser pipe, w_riser (kg/m). Default DN50 ≈ 5.44 kg/m per ASME B36.10 Schedule 40 \citep{engtoolboxSteelPipe}. Replaces the previous "riserDiameterFactor" (a length-multiplier formulation that conflated diameter-driven weight differences with length adjustment); use this unit weight directly against the riser's own length instead.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#waterHeaterDensityPerUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#PlumbingSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">water heater density per unit</rdfs:label>
    <rdfs:comment xml:lang="en">Number of water heaters per served unit (alpha_heater ≈ 1 per unit).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#equivalentAreaFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#HVACSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#StructuralSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/bms#BuildingSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#componentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Component"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#INSUFFICIENT_DATA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/bms#ModelGranularityLevel"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N61e08890d85c43fe939500dd2d218c88">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="Nd9de870c8c144151a72c8459d7c44234"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#hasGranularityLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Building"/>
    <rdfs:range rdf:resource="http://example.org/bms#ModelGranularityLevel"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#servedAreaRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:nodeID="N4b217a25619b4909b8ce69bee18d3435"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#floorToFloorHeight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Building"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#GasSupplySystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/bms#BuildingSystem"/>
    <rdfs:label xml:lang="en">Gas Supply System</rdfs:label>
    <rdfs:comment xml:lang="en">Piped gas distribution system (town gas and/or natural gas, per SS608:2015) comprising steel riser/main pipes and copper branch pipes to individual units. In Singapore, piped gas service is provided primarily to residential premises (HDB/condominium) and to hotel/F&amp;B kitchens; it is not generally supplied to offices or industrial premises \citep{ss608-2015}.</rdfs:comment>
    <calculationFormula>Steel riser+main: H_f=H/N_f [floor-to-floor height, derived; falls back to bms:floorToFloorHeight if directly available]; L_riser=N_f*H_f (=H); L_main=L_f*N_f; S_steel=(L_riser*w_riser + L_main*w_main)*sf3 [each segment uses its OWN diameter-specific unit weight — DN50 riser w_riser≈5.44 kg/m, DN40 main w_main≈4.05 kg/m, ASME B36.10 Schedule 40 — rather than a separate "diameter factor" applied to length, which conflated diameter-driven weight differences with length adjustment]. Copper branch: L_branch=N_unit*alpha_unit; S_copper=L_branch*w_copper*sf3 [DN15, w_copper≈0.42 kg/m, ASTM B88 Type L].</calculationFormula>
    <applicabilityCondition>Applies to building function (bms:function) B1 (landed residential), B2 (condominium), B3 (HDB), and C (hotel, kitchen use) — and, for the copper branch only, to F&amp;B/restaurant premises within commercial (A1) buildings. Generally NOT applicable to A2 (office) or D (industrial), which are not typically served by piped gas in Singapore \citep{ss608-2015}.</applicabilityCondition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfd5a2cee842c49f395d81076daaabe34">
    <rdf:first rdf:resource="http://example.org/bms#Site"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#cableDensityPerArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#ElectricalSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#hasComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#BuildingSystem"/>
    <rdfs:range rdf:resource="http://example.org/bms#Component"/>
    <owl:inverseOf rdf:resource="http://example.org/bms#belongsToSystem"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/bot#hasElement"/>
  </rdf:Description>
