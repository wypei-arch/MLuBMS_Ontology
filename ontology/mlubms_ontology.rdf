  <rdf:Description rdf:about="http://example.org/bms#archetypeUseType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#Archetype"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The building function/use type this archetype represents (same code space as bms:occupancyType on Building), e.g. 'E', 'A2', 'B2'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/bms#selectedGranularityLevel">
