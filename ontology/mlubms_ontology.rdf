  <rdf:Description rdf:about="http://example.org/bms#gasPipeSafetyFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/bms#GasSupplySystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">gas pipe safety factor</rdfs:label>
    <rdfs:comment xml:lang="en">Overall safety factor applied to estimated gas pipe mass (sf3 ≈ 1.15). Engineering design heuristic; not codified in a single published standard.</rdfs:comment>
  </rdf:Description>
